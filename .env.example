REPLAY_MODE=false

PUBLIC_DEMO=false
GRIEVANCE_FOLLOWUP_LIMIT=3
NODAL_FOLLOWUP_LIMIT=2
MIN_OUTBOUND_INTERVAL_HOURS=72
DEMO_OUTBOUND_INTERVAL_SECONDS=10
